# 进程端口
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8080

# SQLite 路径均相对 hr-agent/，也可以在本机 .env 中覆盖为绝对路径。
DATABASE_PATH=data/resumes.sqlite
LEGACY_RESUME_DB_PATH=../patchwork-recruit-gpt/data/resumes.sqlite

# OpenAI 兼容接口；真实 key 只放本机 .env，绝不提交。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5

# 飞书配置预留给面试中心，真实值只放本机 .env。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_LOGIN_REDIRECT_URI=
FEISHU_BITABLE_APP_TOKEN=
AUTO_SYNC_ENABLED=false
AUTO_SYNC_SERVER_URL=
AUTO_SYNC_SECRET=
AUTO_SYNC_SOURCE=local-collector
AUTO_SYNC_INTERVAL_SECONDS=60
AUTO_SYNC_STATE_PATH=data/sync/auto_sync_state.json
AUTO_SYNC_PENDING_DIR=data/sync/pending
FEISHU_CANDIDATE_TABLE_ID=interview_candidates
FEISHU_INTERVIEW_TABLE_ID=interview_sessions
FEISHU_AI_PRODUCT_MANAGER_TABLE_ID=
FEISHU_BOOTSTRAP_ADMIN_NAMES=王鑫力,和新红

# 独立飞书只读招聘机器人。密钥只保存在 lark-cli 的专用 profile 中。
FEISHU_BOT_ENABLED=false
FEISHU_BOT_PROFILE=hr-agent-readonly-bot
FEISHU_BOT_ACCESS_CONFIG_PATH=config/feishu_bot_access.yaml
FEISHU_BOT_RUNTIME_DIR=data/feishu_bot
FEISHU_BOT_CODEX_RUNTIME_DIR=data/feishu_bot/codex-runtime
FEISHU_BOT_MANAGER_RUNS_DIR=data/agent_manager/runs
FEISHU_BOT_CODEX_MODEL=
# 自动化模式只填写网关地址和密钥所在的环境变量名；不要在这里填写密钥。
FEISHU_BOT_CODEX_BASE_URL=
FEISHU_BOT_CODEX_API_KEY_ENV=

# 浏览器后端。默认 fake 仅用于测试；真实运行只能使用 CloakBrowser CDP。
# cloak = 一人一个 CloakBrowser 三平台标签页。
HR_AGENT_BROWSER_BACKEND=fake
DRY_RUN=true
INTERACTION_ENABLED=true
INTERACTION_PROFILE=normal
BOSS_HUMANIZED_INTERACTION_ENABLED=true
BOSS_HUMANIZED_PROFILE=normal

# CloakBrowser CDP 连接。默认按 accounts.yaml 的 cdp_port 拼 http://127.0.0.1:<port>。
CLOAK_CDP=
AGENT_CDP=
# 51job 若服务器没有已打开标签页，可提供入口首页；不填则只复用含 51job.com 的现有页。
JOB51_CHAT_URL=
