# 进程端口
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8080

# SQLite 路径均相对 hr-agent/，也可以在本机 .env 中覆盖为绝对路径。
DATABASE_PATH=data/resumes.sqlite
LEGACY_RESUME_DB_PATH=../patchwork-recruit-gpt/data/resumes.sqlite

# OpenAI 兼容接口；真实 key 只放本机 .env，绝不提交。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5

# 飞书配置预留给面试中心，真实值只放本机 .env。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Phase 7b 浏览器后端。默认 fake；真实验证时用 real 或 real-per-platform。
HR_AGENT_BROWSER_BACKEND=fake
DRY_RUN=true

# CloakBrowser CDP 连接。默认按 accounts.yaml 的 cdp_port 拼 http://127.0.0.1:<port>。
CLOAK_CDP=
AGENT_CDP=
# 可选：旧拓扑按平台分别覆盖。
AGENT_CDP_BOSS=
AGENT_CDP_JOB51=
AGENT_CDP_ZHILIAN=
# 51job 若服务器没有已打开标签页，可提供入口首页；不填则只复用含 51job.com 的现有页。
JOB51_CHAT_URL=
